# Anthropic (Claude) — get at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Resend (email) — get at resend.com
RESEND_API_KEY=re_...

# The "from" email address — must be a verified domain in Resend
FROM_EMAIL=digest@yourdomain.com
FROM_NAME=Investing Digest

# Your app's public URL (no trailing slash)
APP_URL=https://your-app.railway.app

# Database — Railway provides this automatically as DATABASE_URL
# For local development, leave blank to use SQLite
DATABASE_URL=

# Secret for generating tokens (any long random string)
SECRET_KEY=change-this-to-a-long-random-string-please

# For manually triggering a digest via the admin endpoint
ADMIN_SECRET=another-random-string
